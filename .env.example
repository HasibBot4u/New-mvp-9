# ═══════════════════════════════════════════════════
# NexusEdu environment template
# ═══════════════════════════════════════════════════
# Copy to `.env` for local development. In production set these in the
# Render (backend) and Netlify (frontend, VITE_* only) dashboards.
#
# SECURITY:
#   - NEVER commit a real .env file.
#   - Values marked 🔐 are secrets. Never put them in the frontend,
#     GitHub issues, chat, or screenshots.
#   - VITE_* variables are baked into the frontend bundle and are PUBLIC
#     by design. Never put a secret in a VITE_* variable.
#
# Fake values below are placeholders only and do not work.

# ═══════════════════════════════════════════════════
# FRONTEND (Netlify build-time, Vite) — VITE_* are PUBLIC
# ═══════════════════════════════════════════════════
# Supabase project URL (same value as backend SUPABASE_URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon public key (RLS-protected; same as SUPABASE_ANON_KEY)
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Backend API base URL, no trailing slash
VITE_API_BASE_URL=https://your-backend.onrender.com
# Canonical public site URL (SEO/canonical/sitemap). Set to your Netlify URL or custom domain.
VITE_SITE_URL=https://your-site.netlify.app
# [OPTIONAL] Your own Cloudflare Worker for Google-Drive video proxy
VITE_CLOUDFLARE_WORKER_URL=https://your-worker.your-subdomain.workers.dev
# Backend equivalent on Render (only for Drive-source videos)
CLOUDFLARE_WORKER_URL=https://your-worker.your-subdomain.workers.dev
# [OPTIONAL] Set to "true" only if you deliberately want client IP fetch
# for device fingerprinting (disabled by default for privacy).
VITE_ENABLE_IP_FETCH=false

# ═══════════════════════════════════════════════════
# BACKEND CORE (Render runtime)
# ═══════════════════════════════════════════════════
# 🔐 JWT signing secret. Signs short-lived stream tickets. Generate a long
# random string (>=32 chars). Changing it invalidates existing tickets.
JWT_SECRET=generate_a_long_random_string_at_least_32_chars
# 🔐 Admin HMAC token (>=32 chars) for signed admin mutations.
ADMIN_TOKEN=generate_another_long_random_string
# Comma-separated CORS origins (your frontend URL(s))
ALLOWED_ORIGINS=https://your-site.netlify.app
# [OPTIONAL] Port (Render provides PORT automatically)
PORT=8000
# [OPTIONAL] Rate limit floor (per minute)
RATE_LIMIT_PER_MINUTE=60
# [OPTIONAL] Redis URL for distributed rate limiting/caching. If unset,
# the app uses in-memory storage (fine for a single instance).
REDIS_URL=rediss://default:password@host:6379
# [OPTIONAL] Reverse-proxy hops for correct client IP (Render = 1)
TRUSTED_PROXY_HOPS=1

# ═══════════════════════════════════════════════════
# SUPABASE (backend) — 🔐 SERVICE KEY IS SECRET
# ═══════════════════════════════════════════════════
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key-secret

# ═══════════════════════════════════════════════════
# TELEGRAM (backend runtime)
# ═══════════════════════════════════════════════════
# API credentials from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_secret
# 🔐 Pyrogram session string for the account that owns the storage channels
PYROGRAM_SESSION_STRING=your_primary_session_string
# [OPTIONAL] 🔐 Fallback session string
PYROGRAM_SESSION_STRING_2=your_secondary_session_string
# 🔐 Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:your_bot_token
# 🔐 Random webhook secret; set the same value via @BotFather /setsecret
TELEGRAM_WEBHOOK_SECRET=generate_a_webhook_secret
# Your numeric Telegram admin ID(s), comma-separated (from @userinfobot)
ADMIN_CHAT_ID=123456789
# Public webhook URL: <backend>/api/bot_webhook
WEBHOOK_URL=https://your-backend.onrender.com/api/bot_webhook
# [OPTIONAL] Private channel used to store video thumbnails
THUMBNAIL_CHANNEL_ID=-1000000000000

# Telegram STORAGE channels — up to 18 (Physics/Chemistry/Math x 6 cycles).
# The backend auto-queues videos posted to these channels and exposes them
# in /api/channels/health. Leave unused slots as 0. Each value is the
# negative channel ID (e.g. -1001234567890).
PHY_C1_CHANNEL_ID=-1000000000001
PHY_C2_CHANNEL_ID=-1000000000002
PHY_C3_CHANNEL_ID=0
PHY_C4_CHANNEL_ID=0
PHY_C5_CHANNEL_ID=0
PHY_C6_CHANNEL_ID=0
CHE_C1_CHANNEL_ID=-1000000000011
CHE_C2_CHANNEL_ID=0
CHE_C3_CHANNEL_ID=0
CHE_C4_CHANNEL_ID=0
CHE_C5_CHANNEL_ID=0
CHE_C6_CHANNEL_ID=0
HM_C1_CHANNEL_ID=0
HM_C2_CHANNEL_ID=0
HM_C3_CHANNEL_ID=0
HM_C4_CHANNEL_ID=0
HM_C5_CHANNEL_ID=0
HM_C6_CHANNEL_ID=0

# ═══════════════════════════════════════════════════
# RENDER / RUNTIME BEHAVIOR
# ═══════════════════════════════════════════════════
# Render sets RENDER=true automatically.
RENDER=true
# When true (default on free tier) the upload worker skips ffmpeg
# processing. Set false only on a paid instance with ffmpeg installed.
IS_FREE_TIER=true
# [OPTIONAL] Send a startup message to ADMIN_CHAT_ID ("true"/"false")
BOT_NOTIFY_ON_START=true
